{
 "dur": 78.443,
 "lines": [
  {
   "n": 1,
   "s": 0,
   "e": 4.907,
   "text": "Surabaya lagi ngebut bikin sepuluh rumah pompa baru, sebelum puncak musim hujan."
  },
  {
   "n": 2,
   "s": 5.221,
   "e": 10.551,
   "text": "Satu di antaranya dirancang ngangkat dua puluh tiga ribu liter air... setiap detik."
  },
  {
   "n": 3,
   "s": 11.108,
   "e": 15.824,
   "text": "Tapi tunggu. Kenapa air banjir harus dipompa? Bukannya tinggal dialirin ke sungai?"
  },
  {
   "n": 4,
   "s": 16.219,
   "e": 19.289,
   "text": "Masalahnya, pas hujan deras, sungainya ikut penuh."
  },
  {
   "n": 5,
   "s": 19.565,
   "e": 22.524,
   "text": "Permukaan sungai bisa lebih tinggi dari saluran di kampung."
  },
  {
   "n": 6,
   "s": 22.748,
   "e": 25.93,
   "text": "Kalau dibiarin, airnya malah balik masuk ke permukiman."
  },
  {
   "n": 7,
   "s": 26.268,
   "e": 30.423,
   "text": "Di sinilah rumah pompa kerja. Langkah satu: pintu air ditutup."
  },
  {
   "n": 8,
   "s": 30.647,
   "e": 35.242,
   "text": "Air sungai tertahan di luar, air hujan di dalam kota dikumpulin di satu kolam."
  },
  {
   "n": 9,
   "s": 35.615,
   "e": 41.751,
   "text": "Langkah dua: pompa nyala. Airnya diangkat lewat pipa, melewati tanggul, lalu dibuang ke sungai."
  },
  {
   "n": 10,
   "s": 42.107,
   "e": 48.112,
   "text": "Dua puluh tiga ribu liter per detik itu setara lebih dari seribu dua ratus galon air minum. Tiap detik."
  },
  {
   "n": 11,
   "s": 48.984,
   "e": 54.109,
   "text": "Tapi ada titik lemahnya. Kalau air laut lagi pasang, sungainya nggak bisa buang ke laut."
  },
  {
   "n": 12,
   "s": 54.351,
   "e": 57.979,
   "text": "Pompanya ikut kewalahan. Petugas cuma bisa nunggu laut surut."
  },
  {
   "n": 13,
   "s": 58.263,
   "e": 63.763,
   "text": "Makanya rumah pompa Nginden dikasih jalur pintas ke Kali Jagir, biar air lebih cepat terbuang."
  },
  {
   "n": 14,
   "s": 64.118,
   "e": 69.066,
   "text": "Dan musuh terbesarnya: sampah. Nyangkut di saringan, pompanya bisa berhenti."
  },
  {
   "n": 15,
   "s": 69.311,
   "e": 73.359,
   "text": "Jadi kota nggak bebas banjir karena airnya hilang. Airnya diangkat, liter demi liter."
  },
  {
   "n": 16,
   "s": 73.719,
   "e": 77.243,
   "text": "Mau dibongkar apa lagi? Tulis di komentar."
  }
 ],
