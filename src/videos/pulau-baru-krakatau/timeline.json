{
 "dur": 87.861,
 "lines": [
  {
   "n": 1,
   "s": 0.203,
   "e": 5.915,
   "text": "Citra satelit menemukan dua gugus pulau baru di perairan Selat Sunda, dekat Gunung Anak Krakatau."
  },
  {
   "n": 2,
   "s": 6.828,
   "e": 12.324,
   "text": "Letaknya sekitar tujuh ratus lima puluh meter di barat laut, dan enam ratus meter di tenggara gunungnya."
  },
  {
   "n": 3,
   "s": 13.154,
   "e": 18.642,
   "text": "Tapi tunggu. Kok bisa pulau baru muncul begitu saja, tingginya cuma satu sampai dua meter?"
  },
  {
   "n": 4,
   "s": 19.699,
   "e": 24.935,
   "text": "Jawabannya berawal dari erupsi menerus dua puluh lima jam, empat sampai enam September lalu."
  },
  {
   "n": 5,
   "s": 25.706,
   "e": 30.869,
   "text": "Langkah satu: magma dari perut bumi naik lewat celah dan rekahan yang ada di dasar laut."
  },
  {
   "n": 6,
   "s": 31.598,
   "e": 37.538,
   "text": "Langkah dua: magma itu keluar lewat dua titik erupsi baru, bukan longsoran dari tubuh Anak Krakatau."
  },
  {
   "n": 7,
   "s": 38.327,
   "e": 43.284,
   "text": "Langkah tiga: begitu menyentuh air laut, magma mendingin dan mengeras menjadi batuan."
  },
  {
   "n": 8,
   "s": 43.819,
   "e": 48.864,
   "text": "Tumpukan batuan itu makin menimbun, sampai akhirnya menembus permukaan laut dan jadi daratan."
  },
  {
   "n": 9,
   "s": 49.549,
   "e": 55.825,
   "text": "Posisinya segaris dengan rekahan lama: Danan, Rakata, dan Perbuatan. Kayak mengikuti rel yang sama."
  },
  {
   "n": 10,
   "s": 56.419,
   "e": 61.725,
   "text": "Analogi sederhananya: kayak lilin yang meneteskan lelehan ke air dingin, lalu membeku dan menumpuk."
  },
  {
   "n": 11,
   "s": 62.447,
   "e": 67.362,
   "text": "Badan Geologi menyebutnya diduga cikal bakal Gunung Cucu Krakatau, tapi masih dugaan."
  },
  {
   "n": 12,
   "s": 67.828,
   "e": 73.175,
   "text": "Angka pentingnya: Anak Krakatau sekarang cuma sepersepuluh luas Krakatau sebelum delapan belas delapan tiga."
  },
  {
   "n": 13,
   "s": 73.617,
   "e": 78.636,
   "text": "Volumenya bahkan cuma dua sampai lima persen. Jadi dua pulau mungil ini bukan pertanda letusan besar."
  },
  {
   "n": 14,
   "s": 79.16,
   "e": 84.267,
   "text": "Status Anak Krakatau masih Siaga, dan zona satu kilometer di sekitar dua titik baru itu dilarang dimasuki."
  },
  {
   "n": 15,
   "s": 84.677,
   "e": 86.661,
   "text": "Mau dibongkar apa lagi? Tulis di komentar."
  }
 ],
