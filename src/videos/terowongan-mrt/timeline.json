{
 "dur": 85.965,
 "lines": [
  {
   "n": 1,
   "s": 0,
   "e": 5.875,
   "text": "Rabu kemarin, mesin bor raksasa MRT Jakarta muncul menembus dinding Stasiun Mangga Besar."
  },
  {
   "n": 2,
   "s": 6.133,
   "e": 12.331,
   "text": "Tanda seluruh penggalian terowongan di paket ini rampung, sampai sekitar dua puluh delapan meter di bawah tanah."
  },
  {
   "n": 3,
   "s": 12.704,
   "e": 21.699,
   "text": "Tapi tunggu. Di atasnya ada jalan, gedung tua, dan lalu lintas padat. Kok bisa digali tanpa bikin jalan ambles?"
  },
  {
   "n": 4,
   "s": 22.028,
   "e": 25.271,
   "text": "Jawabannya mesin ini: TBM. Diameternya hampir tujuh meter."
  },
  {
   "n": 5,
   "s": 25.77,
   "e": 30.289,
   "text": "Langkah satu: kepala bor berputar, mengikis tanah sedikit demi sedikit."
  },
  {
   "n": 6,
   "s": 30.578,
   "e": 37.748,
   "text": "Tanah kerukannya nggak langsung dibuang. Ditahan dulu di ruang depan, sampai tekanannya sama dengan tanah dan air di sekitarnya."
  },
  {
   "n": 7,
   "s": 38.014,
   "e": 43.167,
   "text": "Itu kuncinya. Bagian depan nggak pernah kosong, jadi tanah di atas nggak ikut runtuh."
  },
  {
   "n": 8,
   "s": 43.535,
   "e": 49.752,
   "text": "Langkah dua: ulir raksasa mengeluarkan tanah pelan-pelan. Kecepatan putarnya mengatur tekanan tadi."
  },
  {
   "n": 9,
   "s": 50.168,
   "e": 55.654,
   "text": "Langkah tiga: lengan robot langsung memasang segmen beton, jadi satu cincin dinding terowongan."
  },
  {
   "n": 10,
   "s": 55.86,
   "e": 62.328,
   "text": "Mesinnya maju dengan mendorong cincin yang barusan dipasang. Kayak ulat yang merangkak sambil membangun lorongnya sendiri."
  },
  {
   "n": 11,
   "s": 62.572,
   "e": 67.986,
   "text": "Celah di balik cincin langsung diisi grout, semacam semen cair, supaya tanah nggak turun."
  },
  {
   "n": 12,
   "s": 68.165,
   "e": 72.253,
   "text": "Hasilnya sekitar tujuh setengah meter sehari, kira-kira lima cincin."
  },
  {
   "n": 13,
   "s": 72.568,
   "e": 75.752,
   "text": "Untuk Fase 2A, ada enam mesin bor yang dikerahkan."
  },
  {
   "n": 14,
   "s": 75.938,
   "e": 82.341,
   "text": "Jadi kota di atas tetap jalan normal, sementara di bawahnya, terowongan terbentuk cincin demi cincin."
  },
  {
   "n": 15,
   "s": 82.586,
   "e": 84.765,
   "text": "Mau dibongkar apa lagi? Tulis di komentar."
  }
 ],
