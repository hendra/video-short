{
 "dur": 87.491,
 "lines": [
  {
   "n": 1,
   "s": 0.163,
   "e": 5.604,
   "text": "Hari ini, InfraNexia menambah seribu empat ratus delapan kilometer fiber optik lagi."
  },
  {
   "n": 2,
   "s": 6.175,
   "e": 11.808,
   "text": "Totalnya seratus dua belas ribu kilometer. Dua puluh enam ribu di antaranya kabel laut."
  },
  {
   "n": 3,
   "s": 12.426,
   "e": 16.809,
   "text": "Tapi tunggu — kok bisa internet melaju ribuan kilometer di bawah laut?"
  },
  {
   "n": 4,
   "s": 17.288,
   "e": 21.796,
   "text": "Rahasianya: datamu bukan listrik, tapi kilatan cahaya."
  },
  {
   "n": 5,
   "s": 22.292,
   "e": 28.67,
   "text": "Langkah satu. Angka satu nol dari foto, chat, dan video kamu diubah jadi pulsa laser."
  },
  {
   "n": 6,
   "s": 29.168,
   "e": 32.781,
   "text": "Pulsa ditembakkan ke serat kaca — setipis rambut manusia."
  },
  {
   "n": 7,
   "s": 33.287,
   "e": 39.165,
   "text": "Langkah dua. Cahaya dipantulkan terus oleh dinding serat — namanya pantulan internal total."
  },
  {
   "n": 8,
   "s": 39.597,
   "e": 44.721,
   "text": "Nggak ada cahaya yang bocor, meski melesat hampir secepat cahaya."
  },
  {
   "n": 9,
   "s": 45.214,
   "e": 50.038,
   "text": "Langkah tiga. Ribuan serat dibundel, dibalut kawat baja, ditanam di dasar laut jadi kabel."
  },
  {
   "n": 10,
   "s": 50.443,
   "e": 55.961,
   "text": "Di ujung-ujungnya berdiri stasiun pantai, lalu sinyal diteruskan ke darat lewat titik akses."
  },
  {
   "n": 11,
   "s": 56.333,
   "e": 60.808,
   "text": "Analoginya kayak selang cahaya sepanjang laut — dindingnya cermin, isinya kilat."
  },
  {
   "n": 12,
   "s": 61.149,
   "e": 67.189,
   "text": "Kalau satu jalur terganggu, trafik antar pusat data dialihkan — targetnya kurang dari lima puluh milidetik."
  },
  {
   "n": 13,
   "s": 67.657,
   "e": 72.064,
   "text": "Total jaringnya seratus dua belas ribu kilometer — sekitar tiga kali keliling bumi."
  },
  {
   "n": 14,
   "s": 72.45,
   "e": 78.753,
   "text": "Didukung satu koma sembilan juta titik akses, trafik AI diprediksi naik sepuluh sampai dua puluh kali lipat."
  },
  {
   "n": 15,
   "s": 79.183,
   "e": 83.485,
   "text": "Jadi… internet antarpulau itu cahaya yang dijaga ketat di dasar laut."
  },
  {
   "n": 16,
   "s": 83.841,
   "e": 86.091,
   "text": "Mau dibongkar apa lagi? Tulis di komentar."
  }
 ],
