{
 "dur": 89.939,
 "lines": [
  {
   "n": 1,
   "s": 0.254,
   "e": 10.5,
   "text": "NASA baru saja mengumumkan rover bertenaga nuklir bernama PROMISE, yang mendarat di Kutub Selatan Bulan."
  },
  {
   "n": 2,
   "s": 11.289,
   "e": 17.826,
   "text": "Wahana beroda enam ini ditargetkan meluncur akhir dua ribu dua puluh delapan, dengan misi sekitar delapan belas bulan."
  },
  {
   "n": 3,
   "s": 18.608,
   "e": 25.29,
   "text": "Tapi tunggu. Di Kutub Selatan itu gelap, beku, dan tidak pernah tersentuh matahari. Kok bisa rover jalan di sana?"
  },
  {
   "n": 4,
   "s": 26.098,
   "e": 30.766,
   "text": "Jawabannya: malam di Bulan panjang, dan panel surya nggak bisa diandalkan di sana."
  },
  {
   "n": 5,
   "s": 31.501,
   "e": 38.104,
   "text": "Langkah satu: PROMISE menggendong sumber panas radioaktif. Panasnya diubah jadi listrik, bukan reaktor yang meledak."
  },
  {
   "n": 6,
   "s": 38.957,
   "e": 45.279,
   "text": "Langkah dua: bor sepanjang sekitar satu meter menggali regolit, atau tanah Bulan, untuk mencari es air."
  },
  {
   "n": 7,
   "s": 46.125,
   "e": 52.392,
   "text": "Langkah tiga: spektrometer dan sensor suhu membaca komposisi materialnya, kamera memotret lokasi terbaik."
  },
  {
   "n": 8,
   "s": 53.212,
   "e": 58.092,
   "text": "Wilayah bayangan permanen di sana suhunya bisa mencapai minus dua ratus tiga derajat celsius."
  },
  {
   "n": 9,
   "s": 58.93,
   "e": 64.167,
   "text": "Es air di sana diduga sudah membeku sejak miliaran tahun lalu, merekam sejarah awal tata surya."
  },
  {
   "n": 10,
   "s": 64.982,
   "e": 70.534,
   "text": "Yang menarik, PROMISE dibangun dari suku cadang rover Mars Curiosity dan Perseverance, supaya hemat biaya."
  },
  {
   "n": 11,
   "s": 71.41,
   "e": 76.06,
   "text": "Kontrak dasarnya sekitar sembilan puluh empat juta dolar diberikan ke Blue Origin, milik Jeff Bezos."
  },
  {
   "n": 12,
   "s": 76.922,
   "e": 81.533,
   "text": "Jadi ini bukan cuma misi cari es, tapi uji coba cara manusia bertahan hidup di Bulan."
  },
  {
   "n": 13,
   "s": 82.403,
   "e": 86.655,
   "text": "Jadi Bulan bukan lagi sekadar tempat berkunjung, tapi calon rumah kedua umat manusia."
  },
  {
   "n": 14,
   "s": 87.477,
   "e": 89.439,
   "text": "Mau dibongkar apa lagi? Tulis di komentar."
  }
 ],
