{
 "dur": 86.475,
 "lines": [
  {
   "n": 1,
   "s": 0.262,
   "e": 6.965,
   "text": "Di Malang, delapan pulau panel surya sedang dibangun mengapung di Waduk Sutami, alias Karangkates."
  },
  {
   "n": 2,
   "s": 7.48,
   "e": 12.715,
   "text": "Kapasitasnya seratus tiga puluh tiga megawatt-peak, terbesar kedua di Indonesia setelah Cirata."
  },
  {
   "n": 3,
   "s": 13.303,
   "e": 20.847,
   "text": "Tapi tunggu. Panel surya kan biasanya di tanah lapang. Kok bisa ngambang di air, tetap stabil, dan listriknya sampai ke PLN?"
  },
  {
   "n": 4,
   "s": 21.265,
   "e": 25.597,
   "text": "Begini ringkasnya: tiga langkah, dari matahari sampai stop kontak."
  },
  {
   "n": 5,
   "s": 26.379,
   "e": 31.995,
   "text": "Langkah satu: ribuan panel dipasang di atas ponton, rakit plastik khusus yang dirancang nggak tenggelam."
  },
  {
   "n": 6,
   "s": 32.263,
   "e": 39.186,
   "text": "Langkah dua: tiap pulau dijangkar ke dasar waduk dengan tali tambat, jadi posisinya nggak geser meski muka air naik turun."
  },
  {
   "n": 7,
   "s": 40.032,
   "e": 45.352,
   "text": "Bonusnya, air di bawah panel itu adem. Panel jadi nggak kepanasan, kerjanya lebih stabil."
  },
  {
   "n": 8,
   "s": 46.299,
   "e": 50.553,
   "text": "Langkah tiga: arus searah dari panel diubah lewat inverter jadi arus bolak-balik."
  },
  {
   "n": 9,
   "s": 51.285,
   "e": 56.636,
   "text": "Listriknya menyusur lewat kabel bawah air menuju gardu di tepi waduk, lalu nyambung ke jaringan PLN."
  },
  {
   "n": 10,
   "s": 57.573,
   "e": 63.117,
   "text": "Total investasinya sekitar sembilan puluh juta dolar AS, dan area panel cuma sekitar tujuh puluh satu hektare."
  },
  {
   "n": 11,
   "s": 63.732,
   "e": 67.422,
   "text": "Itu cuma tiga koma tujuh persen dari permukaan waduk pada muka air tertinggi."
  },
  {
   "n": 12,
   "s": 68.346,
   "e": 72.659,
   "text": "Enam dari delapan pulau sudah terpasang, progres konstruksinya sekitar tujuh puluh persen."
  },
  {
   "n": 13,
   "s": 73.505,
   "e": 76.583,
   "text": "Targetnya mulai beroperasi awal Januari dua ribu dua puluh tujuh."
  },
  {
   "n": 14,
   "s": 77.418,
   "e": 82.29,
   "text": "Jadi, lahan daratan tetap produktif, waduk tetap berfungsi, dan listriknya jalan terus."
  },
  {
   "n": 15,
   "s": 83.079,
   "e": 85.275,
   "text": "Mau dibongkar apa lagi? Tulis di komentar."
  }
 ],
