{
 "dur": 68.05,
 "lines": [
  {
   "n": 1,
   "s": 0.299,
   "e": 5.176,
   "text": "Jumat, enam November, Jembatan Sentong di Bondowoso dibuka lagi setelah diperbaiki."
  },
  {
   "n": 2,
   "s": 5.856,
   "e": 10.934,
   "text": "Truk-truk berat langsung melintas. Tapi kok bisa, ya, jembatan raksasa nanggung ribuan ton?"
  },
  {
   "n": 3,
   "s": 11.779,
   "e": 16.764,
   "text": "Jawabannya kabel pancang. Contohnya Suramadu, jembatan terpanjang di Indonesia."
  },
  {
   "n": 4,
   "s": 17.529,
   "e": 22.921,
   "text": "Bentang utamanya empat ratus tiga puluh empat meter, ditopang dua menara setinggi seratus empat puluh meter."
  },
  {
   "n": 5,
   "s": 23.609,
   "e": 27.793,
   "text": "Kabel baja dipasang seperti kipas, dari puncak menara sampai lantai jembatan."
  },
  {
   "n": 6,
   "s": 28.597,
   "e": 32.906,
   "text": "Baja itu menahan beban hanya dengan gaya tarik, dan baja paling kuat menahan tarik."
  },
  {
   "n": 7,
   "s": 33.659,
   "e": 38.969,
   "text": "Beban lantai disalurkan lewat kabel ke menara, dari menara turun lewat gaya tekan ke fondasi di tanah."
  },
  {
   "n": 8,
   "s": 39.859,
   "e": 45.209,
   "text": "Celah di bawah bentang utama tetap lega, setinggi tiga puluh lima meter, biar kapal besar bebas melintas."
  },
  {
   "n": 9,
   "s": 46.093,
   "e": 50.064,
   "text": "Lima ribu empat ratus meter panjangnya, semuanya digantung sama kabel-kabel itu."
  },
  {
   "n": 10,
   "s": 50.662,
   "e": 54.891,
   "text": "Dan itu bukan beban coba-coba, ya, dua puluh enam ribu kendaraan lewat setiap hari."
  },
  {
   "n": 11,
   "s": 55.649,
   "e": 60.093,
   "text": "Jadi jembatan nggak nahan beban sendirian, dia menyalurkannya lewat jalur yang pas."
  },
  {
   "n": 12,
   "s": 60.797,
   "e": 64.082,
   "text": "Itu sebabnya, Suramadu didesain bertahan sampai seratus tahun ke depan."
  },
  {
   "n": 13,
   "s": 64.739,
   "e": 66.85,
   "text": "Mau dibongkar apa lagi? Tulis di komentar."
  }
 ],
