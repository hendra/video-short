# Copy to .env and fill in. Never commit .env.
# This file IS committed to git — empty placeholders only. Never paste real values from .env into it (no shell `cp`/`cat` of real files into it).
# --- Voiceover providers (npm run tts) ---------------------------------------
# Primary — Google AI Studio (free API key, no billing account):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Voice is locked in code: gemini-3.8-flash-tts + id-id-podcaster-1. Do not add overrides.
# Legacy provider clients remain in code, but `npm run tts` is locked to the voice above
# and rejects them — do not use them to change the production voice.
GCLOUD_TTS_KEY=
# Azure AI Speech F0 (0.5M chars/month free)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Legacy/manual provider override only; automatic runs always stop on failure instead of changing voice:
# TTS_PROVIDER=auto
# --- Publishing (docs/PUBLISHING.md) ------------------------------------------
# Buffer API token. Scopes in use: posts:read + posts:write ONLY (channel list needs account:read).
BUFFER_ACCESS_TOKEN=
# Cloudinary signed upload — cloud `opqimovw`, folder shorts/YYYY-MM-DD/<slug>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Per-run channel account (multi-akun; lihat ops/README.md §2 dan docs/PUBLISHING.md)
# AI Labs di CI tidak memakai prefix secret — GitHub Environments: `kali-aja` dan `ai-labs`.
# Repo secrets ini dipakai Kali Aja sekaligus fallback AI Labs; environment `ai-labs` menimpa per nama. Lokal, isi kunci yang sedang dipakai.
# ACCOUNT=kali-aja

# --- Slack reporting (optional; Web API fallback when Slack MCP is unavailable)
SLACK_BOT_TOKEN=
SLACK_SOCIAL_CHANNEL_ID=
# --- Cloudflare Worker (ops/cloudflare-cron); same SLACK_* keys as above -------
CF_ACCOUNT_ID=
CF_API_TOKEN=
# --- Legacy/optional: ElevenLabs (no longer the default) ----------------------
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/app/voice-library (or GET /v1/voices)
ELEVENLABS_VOICE_ID=
# Optional
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional JSON, e.g. {"stability":0.5,"similarity_boost":0.75}
ELEVENLABS_VOICE_SETTINGS=
VIDEO_SHORT_PAT=