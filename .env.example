# Copy to .env and fill in. Never commit .env.
# --- Voiceover providers (npm run tts) ---------------------------------------
# Primary — Google AI Studio (free API key, no billing account):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides:
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Charon
# Backup 1 — Google Cloud TTS (billing-enabled GCP project; 4M WaveNet chars/month free)
GCLOUD_TTS_KEY=
# GCLOUD_TTS_VOICE=id-ID-Wavenet-B
# Backup 2 — Azure AI Speech F0 (0.5M chars/month free)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# AZURE_SPEECH_VOICE=id-ID-ArdiNeural
# Optional default provider (auto|gemini|gcloud|azure|elevenlabs); --provider flag wins:
# TTS_PROVIDER=auto
# --- Publishing (docs/PUBLISHING.md) ------------------------------------------
# Buffer API token. Scopes in use: posts:read + posts:write ONLY (channel list needs account:read).
BUFFER_ACCESS_TOKEN=
# Cloudinary signed upload — cloud `opqimovw`, folder shorts/YYYY-MM-DD/<slug>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Legacy/optional: ElevenLabs (no longer the default) ----------------------
ELEVENLABS_API_KEY=
# Voice ID from https://elevenlabs.io/app/voice-library (or GET /v1/voices)
ELEVENLABS_VOICE_ID=
# Optional
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Optional JSON, e.g. {"stability":0.5,"similarity_boost":0.75}
ELEVENLABS_VOICE_SETTINGS=
